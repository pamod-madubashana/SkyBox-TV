<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.skybox.tv">

    <!-- Required for Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Optional: disable touchscreen - TV uses D-pad/remote -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Internet permission for Telegram/Media streaming -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.SkyBoxTV">

        <!-- Leanback Launcher - required for Android TV home screen -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkyBoxTV.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

    </application>
</manifest>